; ========================================
; ASTERISK 2 - Lenovo ThinkPad L380
; IP: 10.0.20.101
; Linux Mint 22.2 / Asterisk 20.6.0
; ========================================

[global]
type=global
user_agent=Asterisk2-LAB

; ---------- SIP UDP TRANSPORT ----------

[transport-udp]
type=transport
protocol=udp
bind=10.0.20.101:5060

; ---------- SAMSUNG S24 - SIP 2001 ----------

[2001]
type=endpoint
transport=transport-udp
context=from-phones
disallow=all
allow=alaw
auth=auth2001
aors=2001
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[auth2001]
type=auth
auth_type=userpass
username=2001
password=[REDACTED_FOR_PUBLICATION]

[2001]
type=aor
max_contacts=1
remove_existing=yes
qualify_frequency=30

; ========================================
; SIP TRUNK ASTERISK 2 -> ASTERISK 1
; ========================================

[trunk-a1]
type=endpoint
transport=transport-udp
context=from-a1
disallow=all
allow=alaw
aors=trunk-a1
direct_media=no
media_encryption=no
identify_by=ip

; ---------- STATIC AOR ----------

[trunk-a1]
type=aor
contact=sip:10.0.10.200:5060
qualify_frequency=30

; ---------- IP IDENTIFICATION ----------

[trunk-a1-identify]
type=identify
endpoint=trunk-a1
match=10.0.10.200